# Azure AI Foundry deployment (server-side only - never prefix with NEXT_PUBLIC_)
# Endpoint: the "Target URI" of your deployment, or its base URL, e.g.
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21
#   https://<resource>.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
# Deployment / model name, e.g. gpt-4o-mini
FOUNDRY_MODEL=
